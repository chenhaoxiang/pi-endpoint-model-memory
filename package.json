    "@earendil-works/pi-coding-agent": ">=1.3.0-fork.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-coding-agent-1.3.0-fork.1.tgz",
    "@types/node": "22.19.19",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-agent-core-1.3.0-fork.1.tgz",
    "@earendil-works/pi-ai": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-ai-1.3.0-fork.1.tgz",
