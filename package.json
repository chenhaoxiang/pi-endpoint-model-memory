{
  "name": "pi-endpoint-model-memory",
  "version": "0.3.0",
  "type": "module",
  "description": "Restore the last selected Pi provider and model with endpoint validation and independent endpoint history.",
  "license": "MIT",
  "author": "chenhaoxiang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenhaoxiang/pi-endpoint-model-memory.git"
  },
  "homepage": "https://github.com/chenhaoxiang/pi-endpoint-model-memory#readme",
  "bugs": "https://github.com/chenhaoxiang/pi-endpoint-model-memory/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "model",
    "endpoint",
    "memory"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "docs/releasing.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
